# Copy this file to .env for local development. Do not commit .env.
# Fill secret values through a local secret manager or deployment configuration.

# Web and Supabase Auth
APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=

# Local Supabase Google OAuth. Configure the production values in the Supabase
# Google provider instead of exposing them to the web app.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=

# Database: obtain local values from `supabase status`; do not paste production URLs here.
DATABASE_URL=
DIRECT_DATABASE_URL=
TEST_DATABASE_URL=

# Optional for local E2E/admin setup. The current production runtime does not
# require a Supabase service-role credential.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=knowledge-documents

# Optional Phase 1 Redis/Upstash-compatible wakeup or rate-limit adapter.
# The durable task source of truth remains Postgres.
REDIS_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379

# AI defaults. `fake` makes local and test workflows deterministic and key-free.
AI_PROVIDER=fake
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=
# Optional. When set, the worker stores 1536-dimensional knowledge embeddings;
# lexical retrieval remains available when this is blank.
OPENAI_EMBEDDING_MODEL=

# Upwork monitoring is fail-closed. `fake` is local/test only; `mcp` is the
# opt-in production provider. The worker has a fixed remote transport plus an
# encrypted OAuth vault and PKCE/DCR user-directed connect/callback flow.
# Upwork MCP is https://mcp.upwork.com/mcp and uses OAuth 2.1 with dynamic
# client registration—not an Upwork API key.
UPWORK_MONITOR_PROVIDER=disabled
UPWORK_MCP_MIN_POLL_INTERVAL_SECONDS=300
# Web/worker server secret only. Generate exactly 32 random bytes encoded as base64
# (for example: `openssl rand -base64 32`) and put it in the deployment secret
# manager. Never commit, paste in chat, or expose it through NEXT_PUBLIC_.
UPWORK_MCP_CREDENTIAL_ENCRYPTION_KEY=
# The final, stable public HTTPS callback URL; it must match APP_URL and the
# OAuth provider registration exactly. Example:
# https://app.example.com/api/upwork/oauth/callback
UPWORK_MCP_OAUTH_REDIRECT_URL=
# Use a non-secret internal email/ticket reference in production, never the
# approval email body or credentials.
UPWORK_MCP_APPROVAL_REFERENCE=local-fake

# Development-only job injection. Never enable it in production.
DEV_INGESTION_ENABLED=false
DEV_INGEST_TOKEN=

# Local Playwright auth bridge. This is double-gated and rejected in production.
RUN_E2E=false
E2E_BASE_URL=http://127.0.0.1:3000
E2E_AUTH_ENABLED=false
E2E_AUTH_TOKEN=
E2E_AUTH_EMAIL=
E2E_USER_PASSWORD=

# Worker runtime
WORKER_ID=local-worker-1
WORKER_CONCURRENCY=1
WORKER_HEALTH_PORT=0
WORKER_POLL_INTERVAL_MS=3000
LOG_LEVEL=debug
